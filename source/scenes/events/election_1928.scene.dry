title: Tweede Kamer Elections
new-page: true
tags: event
priority: -1
view-if: (year = next_election_year and month >= next_election_month) or (year > next_election_year)
on-departure: month_actions += 1; in_election = 0; next_election_year = next_election_year + 4; n_elections += 1; next_election_time = time + 48;
set-jump: post_election

# The low priority means that this event is only seen after all other events are resolved for the month.

= Elections, [+ month : month +] [+ year +]

The Tweede Kamer elections are to be held now.

- @election_algorithm: May we do our best...

@election_algorithm
go-to: post_election

@post_election
on-arrival: {!
// store old results and set the new seat shares.
// Q[party + '_votes'] is the raw vote share produced by the campaign phase.
for (var party of Q.parties) {
    Q['old_' + party + '_r'] = Q[party + '_r'];
    Q[party + '_r'] = Q[party + '_votes'];
    Q[party + '_r_disp'] = Q.use_decimals ? Q[party + '_r'].toFixed(1) : Q[party + '_r'];
    Q['change_' + party + '_r'] = Q[party + '_r'] - Q['old_' + party + '_r'];
    var sign = Q['change_' + party + '_r'] > 0 ? '+' : '';
    Q['str_change_' + party] = sign + Q['change_' + party + '_r'];
}

// largest party
Q.largest_party = 'PvdA';
if (Q.vvd_r > Q.pvda_r) {
    Q.largest_party = 'VVD';
}
if (Q.pvv_r > Q.vvd_r && Q.pvv_r > Q.pvda_r) {
    Q.largest_party = 'PVV';
}
if (Q.fvd_r > Q.pvv_r && Q.fvd_r > Q.vvd_r && Q.fvd_r > Q.pvda_r) {
    Q.largest_party = 'FvD';
}

// coalitions (percentages of seats)
Q.pvda_majority = Q.pvda_r;
Q.progressive_coalition = Q.pvda_r + Q.sp_r + Q.d66_r;
Q.purple_coalition = Q.pvda_r + Q.vvd_r + Q.d66_r;
Q.center_left_coalition = Q.pvda_r + Q.cda_r + Q.d66_r;
Q.center_right_coalition = Q.cda_r + Q.d66_r + Q.vvd_r + Q.other_r;
Q.right_coalition = Q.cda_r + Q.vvd_r + Q.other_r + Q.pvv_r;
Q.far_right_coalition = Q.pvv_r + Q.fvd_r;

// reset government and ministers
Q.coalition_dissent = 0;
Q.pvda_in_government = 0;
Q.in_minority_government = 0;
Q.leverage = Q.pvda_r;
Q.foreign_minister_party = 'VVD';
Q.interior_minister_party = 'CDA';
Q.justice_minister_party = 'VVD';
Q.labor_minister_party = 'CDA';
Q.defense_minister_party = 'CDA';
Q.economic_minister_party = Q.d66_name;
Q.finance_minister_party = 'VVD';
Q.agriculture_minister_party = 'CDA';

// reset coalition partner goals
Q.sp_goals_seen = 0;
Q.welfare_goal = 0;
Q.agriculture_goal = 0;
Q.economy_goal = 0;
Q.finance_goal = 0;
Q.labor_goal = 0;
Q.foreign_goal = 0;
Q.interior_goal = 0;
Q.defense_goal = 0;
Q.welfare_goal_completed = 0;
Q.agriculture_goal_completed = 0;
Q.economy_goal_completed = 0;
Q.finance_goal_completed = 0;
Q.labor_goal_completed = 0;
Q.foreign_goal_completed = 0;
Q.interior_goal_completed = 0;
Q.defense_goal_completed = 0;

var election_result = {'date': new Date(Q.year, Q.month - 1)};
for (var party of Q.parties) {
    election_result[party] = Q[party + '_r'];
}
Q.election_records.push(election_result);
!}
on-display: {!
// 150 seats in the Tweede Kamer.
data = [
    {
        "id": "sp",
        "legend": "SP",
        "name": "SP",
        "seats": Math.round(Q.sp_r*1.5),
    },
    {
        "id": "pvda",
        "legend": "PvdA",
        "name": "PvdA",
        "seats": Math.round(Q.pvda_r*1.5),
    },
    {
        "id": "d66",
        "legend": Q.d66_name,
        "name": Q.d66_name,
        "seats": Math.round(Q.d66_r*1.5),
    },
    {
        "id": "cda",
        "legend": "CDA",
        "name": "CDA",
        "seats": Math.round(Q.cda_r*1.5),
    },
    {
        "id": "vvd",
        "legend": "VVD",
        "name": "VVD",
        "seats": Math.round(Q.vvd_r*1.5),
    },
    {
        "id": "other",
        "legend": "Others",
        "name": "Others",
        "seats": Math.round(Q.other_r*1.5),
    },
    {
        "id": "pvv",
        "legend": "PVV",
        "name": "PVV",
        "seats": Math.round(Q.pvv_r*1.5),
    },
    {
        "id": "fvd",
        "legend": "FvD",
        "name": "FvD",
        "seats": Math.round(Q.fvd_r*1.5),
    },
];

if (window && d3) {
    var width = 500;
    var height = 500;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50;
        height = width;
        document.getElementById("tweede_kamer").style.height = screenWidth/2 + "px";
    }

    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#tweede_kamer").datum(data).call(parliament);
}
!}
go-to: coalition_menu

= Election results

{!<svg id="tweede_kamer" style="width: 500px; height: 250px;"> </svg>!}

{!<table>!}
{!<tr><td>Party</td><td>Vote share</td><td>% Change</td></tr>!}
{!<tr><td><div class="box" style='background-color:#8b0000'> </div> !}SP: {!</td><td>!} [+ sp_r +]% {!</td><td>!} [+ str_change_sp +] {!</td></tr>!}
{!<tr><td><div class="box" style='background-color:#ee0000'> </div> !}PvdA: {!</td><td>!} [+ pvda_r +]% {!</td><td>!} [+ str_change_pvda +] {!</td></tr>!}
{!<tr><td><div class="box" style='background-color:#00cd67'> </div> !} [+ d66_name +]: {!</td><td>!} [+ d66_r +]% {!</td><td>!} [+ str_change_d66 +] {!</td></tr>!}
{!<tr><td><div class="box" style='background-color:#008b00'> </div> !}CDA: {!</td><td>!} [+ cda_r +]% {!</td><td>!} [+ str_change_cda +] {!</td></tr>!}
{!<tr><td><div class="box" style='background-color:#3a5fcd'> </div> !}VVD: {!</td><td>!} [+ vvd_r +]% {!</td><td>!} [+ str_change_vvd +] {!</td></tr>!}
{!<tr><td><div class="box" style='background-color:#a0a0a0'> </div> !}Others: {!</td><td>!} [+ other_r +] % {!</td><td>!} [+ str_change_other +] {!</td></tr>!}
{!<tr><td><div class="box" style='background-color:#00008b'> </div> !}PVV: {!</td><td>!} [+ pvv_r +]% {!</td><td>!} [+ str_change_pvv +] {!</td></tr>!}
{!<tr><td><div class="box" style='background-color:#a71c20'> </div> !}FvD: {!</td><td>!} [+ fvd_r +]% {!</td><td>!} [+ str_change_fvd +] {!</td></tr>!}
{!</table>!}

**Potential coalitions:**

Progressive Coalition (PvdA + SP + [+ d66_name +]): [+ progressive_coalition +]%

Purple Coalition (PvdA + VVD + [+ d66_name +]): [+ purple_coalition +]%

Center-left Coalition (PvdA + CDA + [+ d66_name +]): [+ center_left_coalition +]%

Center-right Coalition (CDA + [+ d66_name +] + VVD + Others): [+ center_right_coalition +]%

[? if fvd_r >= 15 : The rise of the FvD is extremely worrying. Some now consider it a serious threat to our democracy. ?]

[? if far_right_coalition >= 50 : Together, PVV and FvD would command a majority. A stable government without them will be very difficult. ?]

There are some potential coalition arrangements.

@coalition_menu

- @pvda_majority
- @progressive_coalition
- @purple_coalition
- @center_left_coalition
- @right_coalition
- @far_right_coalition
- @no_majority

@pvda_majority
title: PvdA majority alone
subtitle: PvdA: [+ pvda_r +]%
view-if: pvda_r >= 50
on-arrival: chancellor = "Empty"; chancellor_party = "PvdA"; pvda_in_government = 1; in_pvda_majority = 1; pro_republic += 5; foreign_minister_party = "PvdA"; foreign_minister = "Ploumen"; interior_minister_party = "PvdA"; interior_minister = "Plasterk"; justice_minister_party = "PvdA"; justice_minister = "Ploumen"; labor_minister_party = "PvdA"; labor_minister = "Klijnsma"; defense_minister_party = "PvdA"; defense_minister = "Klijnsma"; economic_minister_party = "PvdA"; economic_minister = "Dijksma"; finance_minister_party = "PvdA"; finance_minister = "Ploumen"; agriculture_minister_party = "PvdA"; agriculture_minister = "Dijksma"
achievement: majority_party

Finally, the PvdA can govern alone! Our long campaign of electioneering has paid off. We do not need to worry about coalition government; anything is possible.

Who should be the party leader / candidate for Prime Minister?

- @asscher_pm: Lodewijk Asscher for Prime Minister.
- @samsom_pm: Diederik Samsom for Prime Minister.
- @ploumen_pm: Lilianne Ploumen for Prime Minister.

@asscher_pm
on-arrival: chancellor = "Asscher"; chancellor_party = "PvdA"

Lodewijk Asscher has become Prime Minister of the PvdA majority.

@samsom_pm
on-arrival: chancellor = "Samsom"; chancellor_party = "PvdA"

Diederik Samsom has become Prime Minister of the PvdA majority.

@ploumen_pm
on-arrival: chancellor = "Ploumen"; chancellor_party = "PvdA"

Lilianne Ploumen has become Prime Minister of the PvdA majority.


@progressive_coalition
title: A Progressive coalition?
subtitle: PvdA + SP + [+ d66_name +] ([+ progressive_coalition +]%)
unavailable-subtitle: PvdA + SP + [+ d66_name +] ([+ progressive_coalition +]%) - [? if sp_relation < 50 : We do not have adequate relations with the SP. ?][? if d66_relation < 40 : We do not have adequate relations with [+ d66_name +]. ?]
view-if: progressive_coalition >= 50
choose-if: sp_relation >= 50 and d66_relation >= 40
on-arrival: pvda_in_government = 1; in_progressive_coalition = 1; chancellor = "Asscher"; chancellor_party = "PvdA"; sp_relation += 5; labor_minister_party = "PvdA"; labor_minister = "Klijnsma"; finance_minister_party = "PvdA"; finance_minister = "Ploumen"
achievement: progressive_coalition

A progressive coalition of the PvdA, SP, and [+ d66_name +] is possible. This would allow us to pursue ambitious social policy, though the business-friendly parties will protest every step of the way.

[? if largest_party != "PvdA" : Some question whether it is proper for us to lead this government. ?]

- @ministries: First, we must select our ministries.


@purple_coalition
title: A Purple coalition?
subtitle: PvdA + VVD + [+ d66_name +] ([+ purple_coalition +]%)
unavailable-subtitle: PvdA + VVD + [+ d66_name +] ([+ purple_coalition +]%) - [? if vvd_relation < 40 : We do not have adequate relations with the VVD. ?][? if d66_relation < 40 : We do not have adequate relations with [+ d66_name +]. ?]
view-if: purple_coalition >= 50
choose-if: vvd_relation >= 40 and d66_relation >= 40
on-arrival: pvda_in_government = 1; in_purple_coalition = 1; chancellor = "Empty"; chancellor_party = "PvdA"; social_minister_party = "PvdA"; social_minister = "Klijnsma"; finance_minister_party = "VVD"; finance_minister = "Empty"
achievement: purple_coalition

A "Purple" coalition of the PvdA, VVD, and [+ d66_name +], in the tradition of Kok. The VVD will insist on fiscal restraint and market-friendly policy, which will cause dissent on our left flank.

Who should be the candidate for Prime Minister?

- @pvda_pm_purple: One of ours should lead the government.
- @vvd_pm_purple: Let the VVD lead, and we will take the ministries.

@pvda_pm_purple
view-if: largest_party == "PvdA"
on-arrival: chancellor = "Samsom"; chancellor_party = "PvdA"; leverage += 5
go-to: ministries

As the largest party, we have claimed the premiership.

@vvd_pm_purple
on-arrival: chancellor = "Empty"; chancellor_party = "VVD"; leverage += 10
go-to: ministries

We have let the VVD lead the government, in exchange for more influence in the ministries.


@center_left_coalition
title: A Center-left coalition?
subtitle: PvdA + CDA + [+ d66_name +] ([+ center_left_coalition +]%)
unavailable-subtitle: PvdA + CDA + [+ d66_name +] ([+ center_left_coalition +]%) - [? if cda_relation < 45 : We do not have adequate relations with the CDA. ?][? if d66_relation < 40 : We do not have adequate relations with [+ d66_name +]. ?]
view-if: center_left_coalition >= 50
choose-if: cda_relation >= 45 and d66_relation >= 40
on-arrival: pvda_in_government = 1; in_center_left_coalition = 1; chancellor = "Empty"; chancellor_party = "CDA"; labor_minister_party = "PvdA"; labor_minister = "Klijnsma"; foreign_minister_party = "PvdA"; foreign_minister = "Ploumen"
achievement: center_left_coalition

A center-left coalition with the CDA and [+ d66_name +] is possible. The CDA will insist on compromise and consensus, and our more radical members will grumble, but it could be a stable government.

[? if largest_party != "PvdA" : The CDA claims the premiership. ?][? if largest_party == "PvdA" : Some in the CDA question why they should support a government led by us. ?]

- @ministries: First, we must select our ministries.


@right_coalition
title: Refuse to form a government, so that a right-wing coalition may be formed.
subtitle: CDA + VVD + Others + PVV ([+ right_coalition +]%)
unavailable-subtitle: The PVV is not interested in a coalition with the CDA.
view-if: right_coalition >= 50 and largest_party != "PvdA"
on-arrival: pro_republic -= 5; center_dissent += 15; left_dissent += 10; labor_dissent += 25; reformist_dissent += 25; cda_relation -= 5; d66_relation -= 5; vvd_relation -= 5; pvda_in_government = 0; chancellor = "Empty"; chancellor_party = "VVD"

There are enough votes for a right-wing coalition of the CDA, VVD, and minor conservative parties [? if pvv_r >= 15 : with the PVV providing outside support ?]. This will be extremely unpopular within our party, but perhaps it is better to let the right govern and discredit itself.

[? if right_coalition < 50 : However, the PVV refuses to cooperate with the CDA, so this coalition is not possible after all. ?]


@far_right_coalition
title: Far-right coalition
subtitle: FvD + PVV ([+ far_right_coalition +]%)
view-if: far_right_coalition >= 50 and largest_party != "PvdA"
on-arrival: chancellor = "Empty"; chancellor_party = "PVV"; pro_republic -= 15
priority: 2

There are enough votes for the PVV and FvD to form a coalition. Their participation in government is contingent on a hard anti-immigration, anti-establishment program. Our democracy may not survive this.

[? if largest_party == "PvdA" : As the largest party, we were expected to have the first shot at forming a government; our failure to do so has opened the door to the far right. ?]


@no_majority
title: There is no clear governing majority.
view-if: pvda_majority < 50 and progressive_coalition < 50 and purple_coalition < 50 and center_left_coalition < 50 and far_right_coalition < 50
on-arrival: no_majority_elections += 1

There is no path to a workable Tweede Kamer majority. The negotiations drag on for months, frustrating the public and feeding the populist narrative that the establishment is incapable of governing.

- @new_elections: There will be new elections.
- @toleration: We will tolerate a minority government led by the largest party.

@toleration
view-if: largest_party != "PvdA" and center_right_coalition >= 40
on-arrival: pvda_in_government = 0; pvda_toleration = 1; in_minority_government = 1; chancellor = "Empty"; chancellor_party = "VVD"; pro_republic -= 2; leverage = 15

We will tolerate a minority government led by the largest party, without participating in it. This means we will vote against motions of no confidence, but our influence is limited to behind-the-scenes deals.


@new_elections
on-arrival: {!
Q.next_election_month = Q.month + 6;
Q.next_election_time = Q.time + 6;
if (Q.next_election_month > 12) {
    Q.next_election_month -= 12;
    Q.next_election_year = Q.year + 1;
} else {
    Q.next_election_year = Q.year;
}
Q.no_majority_elections += 1;
Q.pro_republic -= 5;
Q.workers_pvda -= 3;
Q.new_middle_pvda -= 3;
Q.old_middle_pvda -= 3;
Q.rural_pvda -= 3;
Q.catholics_pvda -= 3;
Q.workers_fvd += 3;
Q.old_middle_fvd += 2;
Q.new_middle_fvd += 2;
Q.rural_fvd += 2;
Q.unemployed_fvd += 3;
if (Q.pro_republic < 45 && Q.pro_republic >= 38) {
    Q.workers_pvda -= 6;
}
if (Q.pro_republic < 38) {
    Q.workers_pvda *= 0.85;
    Q.new_middle_pvda -= 5;
    Q.old_middle_pvda -= 5;
    Q.rural_pvda -= 5;
    Q.catholics_pvda -= 3;
    Q.workers_fvd += 5;
    Q.old_middle_fvd += 5;
    Q.new_middle_fvd += 5;
    Q.rural_fvd += 5;
    Q.unemployed_fvd += 5;
}
!}

There is no path to a workable majority. The next elections are set for [+ next_election_month : month +] [+ next_election_year +].

The people's faith in politics is shaken by this ordeal. The populists are exploiting the instability to claim that the establishment parties are incapable of governing, and that the country needs a strong leader.


@ministries

We can pick from any number of ministries. Controlling a ministry allows us to directly effect policy in that area.

- #mins_election
- #drop_mins_election

@labor
title: Ministry of Social Affairs and Employment
subtitle: Taking the Social Affairs Ministry is expected of us.
unavailable-subtitle: We do not have enough leverage.
tags: mins_election
choose-if: leverage >= 5
view-if: labor_minister_party != "PvdA"
on-arrival: leverage -= 5; labor_minister_party = "PvdA"; labor_minister = "Klijnsma"
go-to: ministries

Jetta Klijnsma of the PvdA has been appointed Minister of Social Affairs and Employment.

@interior
title: Ministry of the Interior and Kingdom Relations
subtitle: The Interior Ministry controls domestic policy and the security apparatus.
unavailable-subtitle: We do not have enough leverage.
tags: mins_election
choose-if: leverage >= 5
view-if: interior_minister_party != "PvdA"
on-arrival: leverage -= 5; interior_minister_party = "PvdA"; interior_minister = "Plasterk"
go-to: ministries

Ronald Plasterk of the PvdA has been appointed Minister of the Interior.

@finance
title: Ministry of Finance
subtitle: The Finance Ministry controls the government budget and taxes.
unavailable-subtitle: We do not have enough leverage.
tags: mins_election
choose-if: leverage >= 10
view-if: finance_minister_party != "PvdA"
on-arrival: leverage -= 10; finance_minister_party = "PvdA"; finance_minister = "Ploumen"
go-to: ministries

Lilianne Ploumen of the PvdA has been appointed Finance Minister.

@economic
title: Ministry of Economic Affairs
subtitle: The Economic Ministry controls broader economic policy.
unavailable-subtitle: We do not have enough leverage.
tags: mins_election
choose-if: leverage >= 10
view-if: economic_minister_party != "PvdA"
on-arrival: leverage -= 10; economic_minister_party = "PvdA"; economic_minister = "Dijksma"
go-to: ministries

Sharon Dijksma of the PvdA has been appointed Minister of Economic Affairs.

@justice
title: Ministry of Justice and Security
subtitle: The Justice Ministry controls the courts and the police.
unavailable-subtitle: We do not have enough leverage.
tags: mins_election
choose-if: leverage >= 10
view-if: justice_minister_party != "PvdA"
on-arrival: leverage -= 10; justice_minister_party = "PvdA"; justice_minister = "Plasterk"
go-to: ministries

Ronald Plasterk of the PvdA has been appointed Justice Minister.

@foreign
title: Ministry of Foreign Affairs
subtitle: The Foreign Ministry controls diplomacy and development aid.
unavailable-subtitle: We do not have enough leverage.
tags: mins_election
choose-if: leverage >= 10
view-if: foreign_minister_party != "PvdA"
on-arrival: leverage -= 10; foreign_minister_party = "PvdA"; foreign_minister = "Ploumen"
go-to: ministries

Lilianne Ploumen of the PvdA has been appointed Foreign Minister.

@agriculture
title: Ministry of Agriculture, Nature and Food Quality
subtitle: This is not our usual domain.
unavailable-subtitle: We do not have enough leverage.
tags: mins_election
choose-if: leverage >= 10
view-if: agriculture_minister_party != "PvdA"
on-arrival: leverage -= 10; agriculture_minister_party = "PvdA"; agriculture_minister = "Dijksma"
go-to: ministries

Sharon Dijksma of the PvdA has been appointed Agriculture Minister.

@defense
title: Ministry of Defense
subtitle: The armed forces are not typically our domain; the generals will be displeased.
unavailable-subtitle: We do not have enough leverage.
tags: mins_election
choose-if: leverage >= 15
view-if: defense_minister_party != "PvdA"
on-arrival: leverage -= 15; defense_minister_party = "PvdA"; defense_minister = "Klijnsma"
go-to: ministries

Jetta Klijnsma of the PvdA has been appointed Defense Minister.


@no_more
title: No more ministries.
subtitle: [? if leverage >= 10 : We still have some more leverage to gain ministries. ?][? if leverage < 10 : We do not have much leverage left. ?]
tags: mins_election

This coalition arrangement is tolerable to all.

@drop_labor
title: Drop the Social Affairs Ministry.
view-if: labor_minister_party = "PvdA"
on-arrival: labor_minister_party = "CDA"; labor_minister = "Empty"; leverage += 5
tags: drop_mins_election
go-to: ministries

@drop_interior
title: Drop the Interior Ministry.
view-if: interior_minister_party = "PvdA"
on-arrival: interior_minister_party = "CDA"; interior_minister = "Empty"; leverage += 5
tags: drop_mins_election
go-to: ministries

@drop_finance
title: Drop the Finance Ministry.
view-if: finance_minister_party = "PvdA"
on-arrival: finance_minister_party = "VVD"; finance_minister = "Empty"; leverage += 10
